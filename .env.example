PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://...

# Blockchain (Sepolia)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/...
PRIVATE_KEY=0x...            # private key wallet owner/issuer kontrak (JANGAN dibagikan)
CONTRACT_ADDRESS=0x...

# Login admin
JWT_SECRET=isi-dengan-string-acak-panjang-minimal-16-karakter
ADMIN_USERNAME=admin
ADMIN_PASSWORD=minimal-8-karakter

# URL frontend
FRONTEND_URL=http://localhost:3000        # boleh lebih dari satu, pisahkan koma
QR_BASE_URL=http://localhost:3000/verify   # isi QR = QR_BASE_URL/<certId>

# Aktifkan (true) hanya kalau backend ada di belakang proxy (Render/Railway/Nginx)
TRUST_PROXY=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
